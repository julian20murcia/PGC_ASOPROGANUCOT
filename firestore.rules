rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasPortalSession() {
      return signedIn() &&
        request.auth.token.get('firebase', {}).get('sign_in_provider', '') != 'phone';
    }

    function profile() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function isActiveUser() {
      return hasPortalSession() && profile().activo == true;
    }

    function isAdmin() {
      return isActiveUser() && profile().rol == 'ADMIN';
    }

    function isStaff() {
      return isActiveUser() && profile().rol in ['ADMIN', 'OPERARIO'];
    }

    // Árbol de permisos (espejo de lib/core/security/permissions.dart).
    function perms() {
      return profile().get('permisos', null);
    }

    function operatorDefault(m, a) {
      return (m == 'recepcion' && a in ['ver', 'crear', 'exportar']) ||
        (a == 'ver' && m in ['dashboard', 'productores', 'liquidaciones', 'tarifas', 'comunicados', 'asistente']);
    }

    function can(m, a) {
      return isAdmin() || (isActiveUser() && profile().rol == 'OPERARIO' && (
        perms() == null ? operatorDefault(m, a) : (m in perms() && a in perms()[m])
      ));
    }

    function isProducer() {
      return isActiveUser() && profile().rol == 'PRODUCTOR';
    }

    function ownsProducer(productorId) {
      return isProducer() && productorId is string && productorId.size() > 0 &&
        get(/databases/$(database)/documents/productores/$(productorId)).data.uidUsuario == request.auth.uid;
    }

    function audit(logId) {
      return getAfter(/databases/$(database)/documents/auditoria_logs/$(logId)).data;
    }

    function validAudit(collection, id, action, before) {
      let next = request.resource.data;
      return next.get('auditLogId', null) is string &&
        next.get('updatedAt', null) == request.time && next.get('updatedByUid', null) == request.auth.uid &&
        matchesAudit(next, collection, id, action, before);
    }

    function matchesAudit(next, collection, id, action, before) {
      let log = audit(next.auditLogId);
      return log != null && log.logId == next.auditLogId &&
        log.entidadAfectada == collection && log.registroId == id &&
        log.accion == action && log.usuarioUid == request.auth.uid &&
        log.timestamp == request.time && log.valorAnterior == before &&
        log.valorNuevo.diff(next).affectedKeys().hasOnly(['updatedAt']);
    }

    function validConsent() {
      let fields = request.resource.data;
      let notice = get(/databases/$(database)/documents/configuracion/privacidad).data;
      return fields.aceptoHabeasData == true &&
        fields.autorizadoPorUid == request.auth.uid &&
        fields.fechaAutorizacionDatos is string && fields.fechaAutorizacionDatos.size() > 0 &&
        fields.soporteAutorizacion is string &&
        fields.soporteAutorizacion.matches('.*[^ ].*') &&
        fields.soporteAutorizacion.size() <= 120 &&
        fields.avisoPrivacidad == notice &&
        notice.keys().hasAll(['version', 'responsable', 'direccion', 'correo',
          'telefono', 'politicaUrl', 'finalidades', 'derechos']) &&
        notice.version is string && notice.version.size() > 0 &&
        notice.responsable is string && notice.responsable.size() > 0 &&
        notice.direccion is string && notice.direccion.size() > 0 &&
        notice.correo is string && notice.correo.size() > 0 &&
        notice.telefono is string && notice.telefono.size() > 0 &&
        notice.politicaUrl is string && notice.politicaUrl.matches('https://.+') &&
        notice.finalidades is string && notice.finalidades.size() > 0 &&
        notice.derechos is string && notice.derechos.size() > 0;
    }

    function validLogin(uid) {
      let next = request.resource.data;
      let log = audit(next.ultimoAccesoLogId);
      return next.ultimoAcceso == request.time && log.timestamp == request.time &&
        log.logId == next.ultimoAccesoLogId && log.entidadAfectada == 'usuarios' &&
        log.registroId == uid && log.usuarioUid == uid && log.accion == 'INICIAR_SESION';
    }

    match /usuarios/{uid} {
      allow get: if isAdmin() || can('usuarios', 'ver') || can('reportes', 'ver') ||
        (hasPortalSession() && request.auth.uid == uid);
      allow list: if isAdmin() || can('usuarios', 'ver') || can('reportes', 'ver');
      allow create: if isAdmin() && request.resource.data.uid == uid &&
        request.resource.data.rol in ['ADMIN', 'OPERARIO', 'PRODUCTOR'];
      allow update: if (isAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['nombreCompleto', 'documento', 'telefono', 'rol', 'activo']) &&
          request.resource.data.rol in ['ADMIN', 'OPERARIO', 'PRODUCTOR']) ||
        (isActiveUser() && request.auth.uid == uid && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmTokens']) &&
            request.resource.data.fcmTokens is list && request.resource.data.fcmTokens.size() <= 30) ||
          // Sesión única en la app móvil: el último dispositivo en iniciar sesión gana.
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sesionMovilId', 'sesionMovilAt']) &&
            request.resource.data.sesionMovilId is string &&
            request.resource.data.sesionMovilId.size() >= 16 && request.resource.data.sesionMovilId.size() <= 64 &&
            request.resource.data.sesionMovilAt == request.time) ||
          (request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['ultimoAcceso', 'ultimoAccesoLogId']) && validLogin(uid))
        ));
    }

    match /configuracion/privacidad {
      allow get: if isActiveUser() || (resource != null &&
        resource.data.keys().hasOnly(['version', 'responsable', 'direccion',
          'correo', 'telefono', 'politicaUrl', 'finalidades', 'derechos']));
    }

    match /autorizaciones_portal/{uid} {
      allow get: if isAdmin() || (isProducer() && request.auth.uid == uid);
    }

    match /configuracion/finanzas {
      allow get: if isStaff();
      allow write: if can('tarifas', 'crear') &&
        request.resource.data.keys().hasOnly(['precioVentaLitro', 'costoOperativoMensual', 'actualizadoEn', 'actualizadoPorUid']) &&
        request.resource.data.precioVentaLitro is number &&
        request.resource.data.precioVentaLitro >= 0 && request.resource.data.precioVentaLitro <= 99999 &&
        request.resource.data.costoOperativoMensual is number &&
        request.resource.data.costoOperativoMensual >= 0 && request.resource.data.costoOperativoMensual <= 999999999 &&
        request.resource.data.actualizadoEn == request.time &&
        request.resource.data.actualizadoPorUid == request.auth.uid;
    }

    match /productores/{productorId} {
      allow read: if isStaff() || (isProducer() && resource.data.uidUsuario == request.auth.uid);
      allow create: if can('productores', 'crear') && request.resource.data.productorId == productorId &&
        validConsent() && validAudit('productores', productorId, 'CREAR', null);
      allow update: if (can('productores', 'editar') || (can('productores', 'eliminar') &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'estado', 'isSynced', 'auditLogId', 'updatedAt', 'updatedByUid']))) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'uidUsuario', 'codigoAsociado', 'cedula', 'nombres', 'apellidos', 'telefono',
          'nombreFinca', 'vereda', 'estado', 'isSynced', 'auditLogId', 'updatedAt', 'updatedByUid'
        ]) && validAudit('productores', productorId, 'EDITAR', resource.data);
    }

    match /tarifas_leche/{tarifaId} {
      allow read: if isActiveUser();
      allow create: if can('tarifas', 'crear') &&
        request.resource.data.precioPorLitro is number &&
        request.resource.data.precioPorLitro > 0 && request.resource.data.precioPorLitro <= 99999;
      allow update: if can('tarifas', 'crear') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fechaFinVigencia', 'activa']);
    }

    match /recepciones_leche/{recepcionId} {
      function validLiters() {
        return request.resource.data.litros is number &&
          request.resource.data.litros >= 0.01 && request.resource.data.litros <= 5000;
      }

      function validCorrection() {
        let next = request.resource.data;
        let changed = next.diff(resource.data).affectedKeys();
        return resource.data.get('liquidacionId', null) == null &&
          resource.data.get('anulado', false) == false &&
          next.get('auditLogId', null) is string && next.get('updatedAt', null) == request.time &&
          audit(next.auditLogId).motivo is string && audit(next.auditLogId).motivo.size() >= 5 &&
          ((can('recepcion', 'editar') && changed.hasOnly(['litros', 'auditLogId', 'updatedAt', 'updatedByUid']) &&
            changed.hasAny(['litros']) && validLiters() &&
            validAudit('recepciones_leche', recepcionId, 'EDITAR', resource.data)) ||
          (can('recepcion', 'eliminar') && changed.hasOnly(['anulado', 'motivoAnulacion', 'auditLogId', 'updatedAt', 'updatedByUid']) &&
            next.anulado == true && next.motivoAnulacion == audit(next.auditLogId).motivo &&
            validAudit('recepciones_leche', recepcionId, 'ANULAR', resource.data)));
      }

      allow read: if isStaff() || ownsProducer(resource.data.productorId);
      allow create: if can('recepcion', 'crear') && request.resource.data.recepcionId == recepcionId &&
        request.resource.data.operarioUid == request.auth.uid &&
        request.resource.data.productorId is string &&
        request.resource.data.createdAt is string && request.resource.data.createdAt.size() > 0 &&
        request.resource.data.liquidacionId == null && request.resource.data.anulado == false &&
        request.resource.data.isSynced == true && request.resource.data.syncStatus == 'SINCRONIZADO' &&
        validLiters() && validAudit('recepciones_leche', recepcionId, 'CREAR', null);
      allow update: if isStaff() && validCorrection();
    }

    match /liquidaciones/{liquidacionId} {
      allow read: if isStaff() || ownsProducer(resource.data.productorId);
      // La emisión y el bloqueo de entregas se ejecutan en la función de cierre.
      allow update: if can('liquidaciones', 'editar') && resource != null &&
        resource.data.get('estadoPago', null) == 'PENDIENTE' &&
        request.resource.data.estadoPago == 'PAGADA' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'estadoPago', 'fechaPago', 'observacionPago', 'auditLogId', 'updatedAt', 'updatedByUid'
        ]) && request.resource.data.fechaPago is string &&
        request.resource.data.observacionPago is string &&
        request.resource.data.observacionPago.size() >= 3 &&
        validAudit('liquidaciones', liquidacionId, 'EDITAR', resource.data);
    }

    match /notificaciones/{notificacionId} {
      function belongsToProducer() {
        let target = resource.data.destinoProductorId;
        return isProducer() && (target == request.auth.uid || ownsProducer(target));
      }

      allow read: if isStaff() || belongsToProducer() ||
        (isProducer() && resource.data.destinoProductorId == null && resource.data.tipo == 'COMUNICADO');
      allow create: if (isStaff() && (request.resource.data.tipo != 'COMUNICADO' ||
          can('comunicados', 'crear'))) || (
        request.resource.data.tipo == 'RECTIFICACION' && request.resource.data.leida == false &&
        ownsProducer(request.resource.data.destinoProductorId)
      );
      allow update: if isStaff() || (
        belongsToProducer() && request.resource.data.leida == true &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leida'])
      );
      // El personal con permiso borra comunicados; el productor borra sus avisos personales.
      allow delete: if can('comunicados', 'eliminar') || (belongsToProducer() &&
        resource.data.get('destinoProductorId', null) != null &&
        resource.data.get('tipo', '') != 'RECTIFICACION');
    }

    match /auditoria_logs/{logId} {
      function isCurrentVersion(log) {
        let record = getAfter(/databases/$(database)/documents/$(log.entidadAfectada)/$(log.registroId)).data;
        return record.auditLogId == logId && record.updatedAt == request.time &&
          log.timestamp == request.time;
      }

      function isLogin(log) {
        let user = getAfter(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
        return log.entidadAfectada == 'usuarios' && log.accion == 'INICIAR_SESION' &&
          log.registroId == request.auth.uid && log.timestamp == request.time &&
          user.ultimoAccesoLogId == logId && user.ultimoAcceso == request.time;
      }

      allow read: if isAdmin() || can('reportes', 'ver') || can('usuarios', 'ver');
      allow create: if isActiveUser() && request.resource.data.logId == logId &&
        request.resource.data.usuarioUid == request.auth.uid && (
          (request.resource.data.entidadAfectada in ['recepciones_leche', 'productores', 'liquidaciones'] &&
            request.resource.data.accion in ['CREAR', 'EDITAR', 'ANULAR'] &&
            isCurrentVersion(request.resource.data)) ||
          isLogin(request.resource.data) ||
          (request.resource.data.accion == 'SOLICITAR_RECTIFICACION' &&
            request.resource.data.entidadAfectada == 'productores' &&
            ownsProducer(request.resource.data.registroId)) ||
          (request.resource.data.accion != 'INICIAR_SESION' && (
            (request.resource.data.entidadAfectada == 'usuarios' && isAdmin()) ||
            (request.resource.data.entidadAfectada == 'tarifas_leche' && can('tarifas', 'crear')) ||
            (request.resource.data.entidadAfectada == 'configuracion' && can('tarifas', 'crear')) ||
            (request.resource.data.entidadAfectada == 'notificaciones' &&
              (can('comunicados', 'crear') || can('comunicados', 'eliminar')))
          ))
        );
    }
  }
}
